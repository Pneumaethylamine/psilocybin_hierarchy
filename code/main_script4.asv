savefig('partial_residual_plots.fig')
print('partial_residual_plots','-dpng','-r300')

%% Delta from baseline plots

figure('Position', [100 100 1200 800]);

% Create colormap and calculate deltas
colors_p = hsv(length(unique(master_tbl_p.CIMBI_ID)));
colors_n = hsv(length(unique(master_tbl_n.CIMBI_ID)));
all_deltas_insideout = []; all_deltas_asymmetry = []; all_deltas_modularity = [];

% Calculate deltas for both scanners
scanners = {'p', 'n'};
for i = 1:2
    tbl = eval(['master_tbl_' scanners{i}]);
    subjects = unique(tbl.CIMBI_ID);
    for subj = subjects'
        subj_data = tbl(tbl.CIMBI_ID == subj, :);
        baseline_idx = subj_data.time_since_admin < 3;

        baseline_insideout = subj_data.insideout(baseline_idx);
        baseline_asymmetry = subj_data.asymmetry(baseline_idx);
        baseline_modularity = subj_data.modularity_res_1_0(baseline_idx);

        all_deltas_insideout = [all_deltas_insideout; subj_data.insideout - baseline_insideout];
        all_deltas_asymmetry = [all_deltas_asymmetry; subj_data.asymmetry - baseline_asymmetry];
        all_deltas_modularity = [all_deltas_modularity; subj_data.modularity_res_1_0 - baseline_modularity];
    end
end

scanner_names = {'P','N'};

% Plot all measures
for scanner_idx = 1:2  % P then N
    scanner = scanners{scanner_idx};
    scanner_name = scanner_names{scanner_idx};
    tbl = eval(['master_tbl_' scanner]);
    colors = eval(['colors_' scanner]);
    subjects = unique(tbl.CIMBI_ID);

    for measure_idx = 1:3
        subplot(2,3,(scanner_idx-1)*3 + measure_idx)
        hold on

        for subj_idx = 1:length(subjects)
            subj = subjects(subj_idx);
            subj_data = tbl(tbl.CIMBI_ID == subj, :);
            baseline_idx = subj_data.time_since_admin < 3;

            % Handle each measure separately
            if measure_idx == 1
                measure_data = subj_data.insideout;
                baseline_value = measure_data(baseline_idx);
            elseif measure_idx == 2
                measure_data = subj_data.asymmetry;
                baseline_value = measure_data(baseline_idx);
            else
                measure_data = subj_data.modularity_res_1_0;
                baseline_value = measure_data(baseline_idx);
            end

            deltas = measure_data - baseline_value;
            times = subj_data.time_since_admin;

            [sorted_times, sort_idx] = sort(times);
            sorted_deltas = deltas(sort_idx);

            plot(sorted_times, sorted_deltas, '-', 'Color', [colors(subj_idx,:), 0.3])
            scatter(sorted_times, sorted_deltas, 50, colors(subj_idx,:), 'filled', 'MarkerFaceAlpha', 0.8)
        end

        xlabel('Time since administration (min)')
        ylabel('Δ from baseline')
        if scanner_idx == 1
            tau = '6s';
        else
            tau = '6.4s';
        end

        if measure_idx == 1
            measure_title = 'Inside-out';
        elseif measure_idx == 2
            measure_title = 'Asymmetry';
        else
            measure_title = 'Modularity';
        end

        title(sprintf('Scanner %s - %s (Tau %s)', scanner_name, measure_title, tau))

        % Set y limits based on measure
        if measure_idx == 1
            ylim([min(all_deltas_insideout) max(all_deltas_insideout)])
        elseif measure_idx == 2
            ylim([min(all_deltas_asymmetry) max(all_deltas_asymmetry)])
        else
            ylim([min(all_deltas_modularity) max(all_deltas_modularity)])
        end
        % Inside the measure_idx loop, after plotting individual subjects but before grid on:

        % Collect all times and deltas for trend line
        all_times = [];
        all_deltas = [];
        for subj_idx = 1:length(subjects)
            subj = subjects(subj_idx);
            subj_data = tbl(tbl.CIMBI_ID == subj, :);
            baseline_idx = subj_data.time_since_admin < 3;

            if measure_idx == 1
                measure_data = subj_data.insideout;
                baseline_value = measure_data(baseline_idx);
            elseif measure_idx == 2
                measure_data = subj_data.asymmetry;
                baseline_value = measure_data(baseline_idx);
            else
                measure_data = subj_data.modularity_res_1_0;
                baseline_value = measure_data(baseline_idx);
            end

            deltas = measure_data - baseline_value;
            times = subj_data.time_since_admin;

            all_times = [all_times; times];
            all_deltas = [all_deltas; deltas];
        end

        % Sort times and deltas
        [sorted_times, sort_idx] = sort(all_times);
        sorted_deltas = all_deltas(sort_idx);

        % Compute LOESS trend
        smoothed_deltas = smoothdata(sorted_deltas, 'loess', 20);  % Adjust span (20) as needed

        % Plot trend line
        plot(sorted_times, smoothed_deltas, 'k-', 'LineWidth', 2)
        grid on
        hold off
    end
end

savefig('delta_from_baseline_plots.fig')
print('delta_from_baseline_plots','-dpng','-r300')

%% Plot correlations between inside-out and asymmetry
figure('Position', [100 100 800 400]);

% Scanner P correlation
subplot(1,2,1)
scatter(master_tbl_p.insideout, master_tbl_p.asymmetry, 50, 'k', 'filled', 'MarkerFaceAlpha', 0.5)
hold on

% Add regression line
valid_idx = ~isnan(master_tbl_p.insideout) & ~isnan(master_tbl_p.asymmetry);
coef = polyfit(master_tbl_p.insideout(valid_idx), master_tbl_p.asymmetry(valid_idx), 1);
x = linspace(min(master_tbl_p.insideout), max(master_tbl_p.insideout), 100);
y = polyval(coef, x);
plot(x, y, 'r-', 'LineWidth', 2)

% Calculate correlation and p-value
[r_p, p_p] = corr(master_tbl_p.insideout, master_tbl_p.asymmetry, 'rows', 'complete');

% Add correlation info to plot
text(0.05, 0.95, sprintf('r = %.3f\np = %.3e', r_p, p_p), ...
    'Units', 'normalized', 'FontSize', 10, ...
    'HorizontalAlignment', 'left', 'VerticalAlignment', 'top')

xlabel('Inside-out')
ylabel('Asymmetry')
title('Scanner P (Tau 6s)')
grid on

% Scanner N correlation
subplot(1,2,2)
scatter(master_tbl_n.insideout, master_tbl_n.asymmetry, 50, 'k', 'filled', 'MarkerFaceAlpha', 0.5)
hold on

% Add regression line
valid_idx = ~isnan(master_tbl_n.insideout) & ~isnan(master_tbl_n.asymmetry);
coef = polyfit(master_tbl_n.insideout(valid_idx), master_tbl_n.asymmetry(valid_idx), 1);
x = linspace(min(master_tbl_n.insideout), max(master_tbl_n.insideout), 100);
y = polyval(coef, x);
plot(x, y, 'r-', 'LineWidth', 2)

% Calculate correlation and p-value
[r_n, p_n] = corr(master_tbl_n.insideout, master_tbl_n.asymmetry, 'rows', 'complete');

% Add correlation info to plot
text(0.05, 0.95, sprintf('r = %.3f\np = %.3e', r_n, p_n), ...
    'Units', 'normalized', 'FontSize', 10, ...
    'HorizontalAlignment', 'left', 'VerticalAlignment', 'top')

xlabel('Inside-out')
ylabel('Asymmetry')
title('Scanner N (Tau 6.4s)')
grid on

savefig('metric_correlations.fig')
print('metric_correlations','-dpng','-r300')

% Display correlations
fprintf('\nCorrelations between Inside-out and Asymmetry:\n');
fprintf('Scanner P: r = %.3f, p = %.3e\n', r_p, p_p);
fprintf('Scanner N: r = %.3f, p = %.3e\n', r_n, p_n);